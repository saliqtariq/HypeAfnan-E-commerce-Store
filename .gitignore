# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# -------------------------------------------------------
# LOCAL-ONLY ASSETS — never commit to GitHub
# These are large files generated locally by scraper/downloader scripts.
# Re-generate them by running the scripts in /scripts/.
# -------------------------------------------------------

# Downloaded product images (40k+ WebP files, ~several GB)
public/images/products/
public/images/products/*

# Downloaded category thumbnails — intentionally TRACKED in git
# Only 165 files / 2.28 MB — safe to commit, needed for Vercel deployment
# public/images/categories/ is NOT ignored (fully local & independent from any CDN)

# Large scraped product databases (re-generatable via scripts)
app/data/products.json
app/data/products_index.json
app/data/products_local.json

# Download progress checkpoint
app/data/download_checkpoint.json

# Category tag mapping (re-generatable)
app/data/product_tags.json
app/data/tag_map.json

# Raw Szwego API scrape artifacts
szwego_tags.json
szwego_api_sample.json

